@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Products</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <button id="btnCreateProduct" type="button" class="btn btn-sm btn-primary px-3 shadow-sm">
            <i class="fa-solid fa-plus me-2"></i>Add Product
        </button>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table id="productsTable" class="table table-striped table-hover width-100" style="width:100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Purchase Price</th>
                        <th>Sale Price</th>
                        <th>Quantity</th>
                        <th style="width: 150px;" class="text-center">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript">
        $(document).ready(function () {
        var token = $('input[name="__RequestVerificationToken"]').val();

        var table = $('#productsTable').DataTable({
        "processing": true,
        "serverSide": true,
        "filter": true,
        "orderMulti": false,
        "ajax": {
        "url": "@Url.Action("GetTableData", "Products")",
        "type": "POST",
        "headers": { 'RequestVerificationToken': token }
        },
        "columns": [
        { "data": "id", "name": "id" },
        { "data": "name", "name": "name" },
        {
        "data": "purchasePrice",
        "name": "purchaseprice",
        "render": function (data) { return "$" + parseFloat(data).toFixed(2); }
        },
        {
        "data": "salePrice",
        "name": "saleprice",
        "render": function (data) { return "$" + parseFloat(data).toFixed(2); }
        },
        { "data": "quantity", "name": "quantity" },
        {
        "data": "id",
        "orderable": false,
        "searchable": false,
        "className": "text-center",
        "render": function (data, type, row) {
        return `<div class="btn-group" role="group">
        <button class="btn btn-sm btn-outline-secondary edit-product-btn" data-id="${data}"><i class="fa-solid fa-pen-to-square me-1"></i>Edit</button>
        <button class="btn btn-sm btn-outline-danger delete-product-btn" data-id="${data}"><i class="fa-solid fa-trash me-1"></i>Delete</button>
        </div>`;
        }
        }
        ],
        "order": [[0, "asc"]]
        });

        // CREATE Action
        $('#btnCreateProduct').on('click', function () {
        $.ajax({
        url: "@Url.Action("CreateModal", "Products")",
        type: "GET",
        success: function (htmlResult) {
        Swal.fire({
        title: '<div class="text-start border-bottom pb-2 w-100 fw-bold"><i class="fa-solid fa-circle-plus text-primary me-2"></i>Add New Product</div>',
        html: '<div id="modalFormContainer" class="w-100">' + htmlResult + '</div>',
        width: '550px',
        showCancelButton: true,
        confirmButtonText: 'Save Product',
        cancelButtonText: 'Cancel',
        customClass: {
        popup: 'border-0 shadow-lg rounded-3',
        htmlContainer: 'mx-0 text-start',
        confirmButton: 'btn btn-primary px-4',
        cancelButton: 'btn btn-link link-secondary text-decoration-none'
        },
        buttonsStyling: false,
        didOpen: function() {
        $.validator.unobtrusive.parse($('#createProductForm'));
        },
        preConfirm: () => {
        var form = $('#createProductForm');
        if (!form.valid()) {
        return false;
        }

        var purchaseVal = parseFloat(form.find('[name="PurchasePrice"]').val());
        var saleVal = parseFloat(form.find('[name="SalePrice"]').val());
        if(saleVal < purchaseVal) {
        Swal.showValidationMessage("The sale price cannot be lower than the purchase price.");
        return false;
        }

        return $.ajax({
        url: form.attr('action'),
        type: 'POST',
        data: form.serialize()
        }).then(response => {
        if (response.isSuccess === false) {
        Swal.showValidationMessage(response.error.description || "Submission error.");
        return false;
        }
        return response;
        }).catch(() => {
        Swal.showValidationMessage("Request failed.");
        });
        }
        }).then((result) => {
        if (result.isConfirmed) {
        Swal.fire({ title: 'Saved!', text: 'Product added successfully.', icon: 'success', timer: 1500, showConfirmButton: false });
        table.ajax.reload(null, false);
        }
        });
        }
        });
        });

        // EDIT Action
        $('#productsTable').on('click', '.edit-product-btn', function () {
        var productId = $(this).data('id');
        $.ajax({
        url: "@Url.Action("EditModal", "Products")",
        type: "GET",
        data: { id: productId },
        success: function (htmlResult) {
        Swal.fire({
        title: '<div class="text-start border-bottom pb-2 w-100 fw-bold"><i class="fa-solid fa-pen-to-square text-secondary me-2"></i>Edit Product Details</div>',
        html: '<div id="modalFormContainer" class="w-100">' + htmlResult + '</div>',
        width: '550px',
        showCancelButton: true,
        confirmButtonText: 'Save Changes',
        cancelButtonText: 'Cancel',
        customClass: {
        popup: 'border-0 shadow-lg rounded-3',
        htmlContainer: 'mx-0 text-start',
        confirmButton: 'btn btn-primary px-4',
        cancelButton: 'btn btn-link link-secondary text-decoration-none'
        },
        buttonsStyling: false,
        didOpen: function() {
        $.validator.unobtrusive.parse($('#editProductForm'));
        },
        preConfirm: () => {
        var form = $('#editProductForm');
        if (!form.valid()) {
        return false;
        }

        var purchaseVal = parseFloat(form.find('[name="PurchasePrice"]').val());
        var saleVal = parseFloat(form.find('[name="SalePrice"]').val());
        if(saleVal < purchaseVal) {
        Swal.showValidationMessage("The sale price cannot be lower than the purchase price.");
        return false;
        }

        return $.ajax({
        url: form.attr('action'),
        type: 'POST',
        data: form.serialize()
        }).then(response => {
        if (response.isSuccess === false) {
        Swal.showValidationMessage(response.error.description || "Submission error.");
        return false;
        }
        return response;
        }).catch(() => {
        Swal.showValidationMessage("Request failed.");
        });
        }
        }).then((result) => {
        if (result.isConfirmed) {
        Swal.fire({ title: 'Updated!', text: 'Changes saved successfully.', icon: 'success', timer: 1500, showConfirmButton: false });
        table.ajax.reload(null, false);
        }
        });
        }
        });
        });

        // DELETE Action (Centered)
        $('#productsTable').on('click', '.delete-product-btn', function () {
        var productId = $(this).data('id');
        Swal.fire({
        title: 'Are you sure?',
        text: "You are about to delete this product. This step cannot be undone.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, delete it',
        cancelButtonText: 'No, keep it',
        customClass: { popup: 'border-0 shadow-lg rounded-3' }
        }).then((result) => {
        if (result.isConfirmed) {
        $.ajax({
        url: "@Url.Action("Delete", "Products")",
        type: "POST",
        data: { id: productId, __RequestVerificationToken: token },
        success: function (response) {
        if (response.isSuccess) {
        Swal.fire({ title: 'Deleted!', text: 'Product removed from catalog.', icon: 'success', timer: 1500, showConfirmButton: false });
        table.ajax.reload(null, false);
        }
        }
        });
        }
        });
        });
        });
    </script>
}