@model UpdateProductViewModel

<form id="editProductForm" asp-action="EditModal" asp-controller="Products" method="post" class="text-start px-1 mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProductId" />

    <div class="mb-3">
        <div class="form-floating">
            <input asp-for="Name" class="form-control" placeholder=" " style="border-radius: 0.5rem;" />
            <label asp-for="Name" class="text-secondary">
                <i class="fa-solid fa-box-open me-2 text-primary"></i>Product Name
            </label>
        </div>
        <span asp-validation-for="Name" class="text-danger small mt-1 d-block ps-1"></span>
    </div>

    <div class="mb-3">
        <div class="form-floating">
            <input asp-for="PurchasePrice" type="number" step="0.01" class="form-control" placeholder=" " style="border-radius: 0.5rem;" />
            <label asp-for="PurchasePrice" class="text-secondary">
                <i class="fa-solid fa-tag me-2 text-success"></i>Purchase Price ($)
            </label>
        </div>
        <span asp-validation-for="PurchasePrice" class="text-danger small mt-1 d-block ps-1"></span>
    </div>

    <div class="mb-3">
        <div class="form-floating">
            <input asp-for="SalePrice" type="number" step="0.01" class="form-control" placeholder=" " style="border-radius: 0.5rem;" />
            <label asp-for="SalePrice" class="text-secondary">
                <i class="fa-solid fa-comments-dollar me-2 text-warning"></i>Sale Price ($)
            </label>
        </div>
        <span asp-validation-for="SalePrice" class="text-danger small mt-1 d-block ps-1"></span>
    </div>

    <div class="mb-2">
        <div class="form-floating">
            <input asp-for="Quantity" type="number" class="form-control" placeholder=" " style="border-radius: 0.5rem;" />
            <label asp-for="Quantity" class="text-secondary">
                <i class="fa-solid fa-cubes me-2 text-info"></i>Available Stock Quantity
            </label>
        </div>
        <span asp-validation-for="Quantity" class="text-danger small mt-1 d-block ps-1"></span>
    </div>
</form>